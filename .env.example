# ============================================================
# AI Career Platform — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# --- MongoDB ---
MONGODB_URI=mongodb://mongo:27017/ai_career_platform

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Firebase Admin (Backend) ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- Firebase Web (Frontend) ---
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# --- AI Provider (OpenAI / Groq / OpenRouter) ---
AI_API_KEY=your-ai-api-key
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# --- JWT ---
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars

# --- Service Ports ---
API_GATEWAY_PORT=5000
USER_SERVICE_PORT=5001
RESUME_SERVICE_PORT=5002
INTERVIEW_SERVICE_PORT=5003
AI_SERVICE_PORT=5004
FEEDBACK_SERVICE_PORT=5005
ROADMAP_SERVICE_PORT=5006

# --- Service URLs (used by API Gateway) ---
USER_SERVICE_URL=http://user-service:5001
RESUME_SERVICE_URL=http://resume-service:5002
INTERVIEW_SERVICE_URL=http://interview-service:5003
AI_SERVICE_URL=http://ai-service:5004
FEEDBACK_SERVICE_URL=http://feedback-service:5005
ROADMAP_SERVICE_URL=http://roadmap-service:5006

# --- AWS (optional, for production) ---
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=ai-career-platform-uploads

# --- Frontend API URL ---
VITE_API_URL=http://localhost:5000
